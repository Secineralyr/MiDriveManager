{
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxfmt/main/npm/oxfmt/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 100,
	"semi": true,
	"singleQuote": true,
	"trailingComma": "all",
	"arrowParens": "always",
	"bracketSpacing": true,
	"ignorePatterns": []
}
